<?xml version="1.0" encoding="utf-8"?>
<!-- Branded Mobile App CUSTOMER SHELL (Luigi 2026-08-02).
     Tenant identity (applicationId, label, deep-link host) is injected at
     build time — app_name/title_activity_main come from gradle resValue and
     ${ffDeepLinkHost} from manifestPlaceholders. Keep permissions MINIMAL:
     internet + push only. No location, no exact alarms — every extra
     permission is store-review surface for N tenant apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified app links for the tenant's own host: push taps,
                 order-status links from email/SMS, and the PayPal return leg
                 all reopen THIS app instead of the browser. Verification is
                 served per-host by /.well-known/assetlinks.json (dynamic
                 route resolves Host → tenant package + cert fingerprints). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${ffDeepLinkHost}" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions — deliberately minimal (see header). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime permission for order-status pushes; requested
         in-app AFTER the first order, never on launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
